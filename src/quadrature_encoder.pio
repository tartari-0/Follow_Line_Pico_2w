.program quadrature_encoder

; Decodificador de quadratura 4X com filtro de ruído.
;   X = contagem, Y = último estado estável dos canais (B:A, 2 bits)
; Uma transição só é aceita se o novo estado for lido igual duas vezes, com
; 32 ciclos de intervalo (6,4 us com a SM a 5 MHz). Ruído do PWM/escovas nos fios
; do encoder (pulsos curtos) é descartado; as bordas reais ficam > 30 us
; uma da outra mesmo na velocidade máxima.
; Requer IN_COUNT = 2 (RP2350): "mov x, pins" lê só os 2 pinos do encoder.

; Tabela de transição (precisa ficar no endereço 0: "mov pc, isr" pula direto
; para a linha anterior<<2 | atual)
.origin 0
    jmp update      ; 00 -> 00 (sem mudança)
    jmp minus       ; 00 -> 01
    jmp plus        ; 00 -> 10
    jmp update      ; 00 -> 11 (inválido: pulou um estado)
    jmp plus        ; 01 -> 00
    jmp update      ; 01 -> 01
    jmp update      ; 01 -> 10
    jmp minus       ; 01 -> 11
    jmp minus       ; 10 -> 00
    jmp update      ; 10 -> 01
    jmp update      ; 10 -> 10
    jmp plus        ; 10 -> 11
    jmp update      ; 11 -> 00
    jmp plus        ; 11 -> 01
    jmp minus       ; 11 -> 10
    jmp update      ; 11 -> 11

plus:
    mov x, ~x       ; X = X + 1 (o PIO só sabe decrementar: ~(~X - 1))
    jmp x-- plus_end
plus_end:
    mov x, ~x
    jmp update

minus:
    jmp x-- update  ; X = X - 1

update:
    mov isr, x
    push noblock    ; Envia a contagem para a CPU (descarta se a fila estiver cheia)
    mov osr, x      ; Guarda a contagem: X e Y serão usados na comparação
    mov isr, y      ; ISR = estado anterior
sample:
    mov x, pins [31] ; Amostra 1 e espera 32 ciclos
    mov y, pins      ; Amostra 2
    jmp x!=y sample  ; Instável (ruído ou borda acontecendo): amostra de novo
    in y, 2          ; ISR = anterior << 2 | atual
    mov x, osr       ; Restaura a contagem
    mov pc, isr      ; Pula para a linha da tabela


% c-sdk {
#include "hardware/pio.h"
#include "hardware/clocks.h"
static inline void quadrature_encoder_program_init(PIO pio, uint sm, uint offset, uint pin, uint pio_freq_hz) {
    pio_sm_config c = quadrature_encoder_program_get_default_config(offset);

    // Mapeia os 2 pinos sequenciais e mascara os demais nas leituras ("mov x, pins")
    sm_config_set_in_pins(&c, pin);
    sm_config_set_in_pin_count(&c, 2);
    pio_gpio_init(pio, pin);
    pio_gpio_init(pio, pin + 1);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 2, false);

    gpio_pull_up(pin);
    gpio_pull_up(pin + 1);

    // Shift para a esquerda, sem auto-push
    sm_config_set_in_shift(&c, false, false, 32);

    // O clock define o filtro: 32 ciclos de estabilidade exigida
    sm_config_set_clkdiv(&c, (float)clock_get_hz(clk_sys) / pio_freq_hz);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
