.program encoder1

; Tabela de transição de estados 4X para Quadratura
.origin 0
    jmp update      ; 00 -> 00 (sem mudança)
    jmp minus       ; 00 -> 01 (girou sentido anti-horário)
    jmp plus        ; 00 -> 10 (girou sentido horário)
    jmp update      ; 00 -> 11 (ruído elétrico/inválido)
    jmp plus        ; 01 -> 00
    jmp update      ; 01 -> 01
    jmp update      ; 01 -> 10
    jmp minus       ; 01 -> 11
    jmp minus       ; 10 -> 00
    jmp update      ; 10 -> 01
    jmp update      ; 10 -> 10
    jmp plus        ; 10 -> 11
    jmp update      ; 11 -> 00
    jmp plus        ; 11 -> 01
    jmp minus       ; 11 -> 10
    jmp update      ; 11 -> 11

; --- LÓGICA DE CONTAGEM ---
plus:
    mov x, ~x       ; Inverte X
    jmp x-- nop_p   ; Decrementa X
nop_p:
    mov x, ~x       ; Inverte novamente (O resultado prático é: X = X + 1)
    jmp update

minus:
    jmp x-- update  ; Decrementa X (X = X - 1)

; --- LOOP PRINCIPAL DO PIO ---
update:
    mov isr, x      ; Pega a contagem atual (X)
    push noblock    ; Envia para a CPU silenciosamente (se a fila encher, ele descarta os velhos)
    
    mov isr, null   ; Limpa a variável de trabalho (ISR)
    in y, 2         ; Puxa os 2 bits do estado passado (giro anterior)
    in pins, 2      ; Puxa os 2 bits do estado atual (os pinos 16 e 17)
    mov y, isr      ; Salva o estado atual para o próximo ciclo
    mov pc, isr     ; A MÁGICA: Usa os bits para pular direto para a linha certa na tabela de transição!


; --- EXPORTAÇÃO AUTOMÁTICA PARA O C ---
% c-sdk {
#include "hardware/pio.h"
static inline void encoder_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = encoder_program_get_default_config(offset);
    
    // Mapeia os 2 pinos sequenciais (Ex: 16 e 17)
    sm_config_set_in_pins(&c, pin);
    pio_gpio_init(pio, pin);
    pio_gpio_init(pio, pin + 1);
    
    // Configura pull-ups mecânicos
    gpio_pull_up(pin);
    gpio_pull_up(pin + 1);
    
    // Configura shift para a esquerda, sem auto-push (Bits novos entram pelo lado certo)
    sm_config_set_in_shift(&c, false, false, 32);
    
    // Liga a Máquina de Estado em potência máxima
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}